# ==========================================
# Lynceus Environment Configuration Example
# ==========================================

# Application Settings

APP_NAME=Lynceus
ENV=development
LOG_LEVEL=info

# Backend / API Settings

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change_this_to_a_secure_random_string

# SNMP Defaults (Used if not explicitly passed in requests)

DEFAULT_SNMP_COMMUNITY_READ=public
DEFAULT_SNMP_COMMUNITY_WRITE=private
DEFAULT_SNMP_VERSION=v2c
DEFAULT_SNMP_PORT=161
SNMP_TIMEOUT=2.0
SNMP_RETRIES=2

