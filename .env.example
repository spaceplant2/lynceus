# LYNCEUS_MASTER_KEY: 256-bit master encryption key for AES-256-GCM envelope encryption
# Protects all SNMP communities, SNMP v3 USM secrets, and login credentials stored in SQLite (vault.db).
# If omitted, a persistent key is automatically generated and secured in config/.master.key.
LYNCEUS_MASTER_KEY="your-256-bit-master-passphrase-here"
PORT=3000
NODE_ENV=production
CONFIG_DIR=/app/config
